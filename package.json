{
  "name": "canopy",
  "version": "0.1.0",
  "description": "A lazy, AI-assisted layer over git",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "canopy": "./bin/canopy.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/server/index.js",
    "seed": "tsx scripts/seed.ts",
    "server": "tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "check-claims": "tsx scripts/check-claims.ts",
    "bakeoff": "tsx scripts/bakeoff.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "trace:demo": "tsx scripts/trace-demo.ts"
  },
  "keywords": [
    "git",
    "lazy",
    "vcs",
    "monorepo",
    "gemma",
    "hacktoberfest"
  ],
  "author": "Sayem Rahman",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
