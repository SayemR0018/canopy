# Canopy Environment Configuration

# LLM Layer (Single OpenAI-compatible interface)
CANOPY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CANOPY_LLM_MODEL=models/gemma-4-26b-a4b-it
CANOPY_LLM_API_KEY=your_google_ai_studio_api_key_here

# Local alternative with Ollama:
# CANOPY_LLM_BASE_URL=http://localhost:11434/v1
# CANOPY_LLM_MODEL=gemma:2b
# CANOPY_LLM_API_KEY=ollama

# Server & Data
PORT=3000
DATA_DIR=./data
PUBLIC_READONLY=false
DAILY_TOKEN_CAP=200000
RATE_LIMIT_PER_MIN=60
SENTRY_DSN=
